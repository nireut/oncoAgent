# oncoAgent — environment variables
# ---------------------------------
# Copy this file to .env.local and fill in the values you need.
# Only the Neo4j block is required to run the demo locally; the rest
# enables optional features (chat provider, web search, Supabase mode).

# ──────────────────────────────────────────────────────────────────────
# Neo4j Aura — REQUIRED for the vault knowledge graph
# ──────────────────────────────────────────────────────────────────────
# Bolt URI from your Aura instance (https://console.neo4j.io)
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<instance-id>
NEO4J_PASSWORD=<your-aura-password>
NEO4J_DATABASE=<instance-id>

# Optional / informational — only used by the build-graph script header.
AURA_INSTANCEID=<instance-id>
AURA_INSTANCENAME=oncoAgent

# ──────────────────────────────────────────────────────────────────────
# Chat provider — OPTIONAL (only needed if you use the AgentChat sidebar)
# ──────────────────────────────────────────────────────────────────────
# Which provider the chat tool routes through. Defaults to "azure".
# Set to "pioneer" to use Pioneer's Qwen-based provider.
CHAT_PROVIDER=azure

# Azure OpenAI — used when CHAT_PROVIDER=azure (the default).
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-key>
# AZURE_OPENAI_MODEL=gpt-5-mini  # default

# Pioneer — used when CHAT_PROVIDER=pioneer, and always for the GLiNER2
# entity-extraction tool exposed in the chat.
PIONEER_API_KEY=<your-pioneer-key>
# PIONEER_BASE_URL=https://api.pioneer.ai/v1                   # default
# PIONEER_CHAT_MODEL=Qwen/Qwen3-235B-A22B                      # default
PIONEER_NER_MODEL=<your-fine-tuned-gliner2-model-id>
# PIONEER_NER_THRESHOLD=0.3                                    # default

# ──────────────────────────────────────────────────────────────────────
# Tavily — OPTIONAL (web-search tool inside the chat)
# ──────────────────────────────────────────────────────────────────────
# Without this, the search tool returns "Tavily not configured" gracefully.
TAVILY_API_KEY=<your-tavily-key>

# ──────────────────────────────────────────────────────────────────────
# Supabase — OPTIONAL (only when running with persistent storage)
# ──────────────────────────────────────────────────────────────────────
# Leave NEXT_PUBLIC_USE_SUPABASE unset (or "false") to run in mock-data
# mode — the demo (Linda Phase 1 / Phase 2 cascade) works fully in that
# mode, no Supabase project required.
NEXT_PUBLIC_USE_SUPABASE=false
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
